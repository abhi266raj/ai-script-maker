    step_names = STAGE_NAMES

    if st.session_state.get("generation_error"):
        failure = st.session_state.generation_error
        _f_step = failure.get("step")
        _f_msg = str(failure.get("message", "")).lower()
        _is_validation = (_f_step == 6) or ("validation" in _f_msg and "generation" not in _f_msg)
        # Prominent stage indicator: AT WHICH STAGE it failed (never "Stage None")
        if _f_step and 1 <= _f_step <= len(step_names):
            _stage_name = step_names[_f_step - 1]
            _stage_label = f"Stage {_f_step}: {_stage_name}"
        else:
            _stage_name = "Unknown Stage"
            _stage_label = "Stage unknown — the failure happened before stage tracking began"
        if _is_validation:
            st.error(f"❌ Script validation found issues — Failed at {_stage_label}")
        else:
            st.error(f"❌ Script generation failed — Failed at {_stage_label}")
        st.info(f"📍 Current stage being worked on: **{_stage_label}**")
        st.write(f"Selected model: **{ENGINE_NAMES_REV.get(failure['engine_mode'], failure['engine_mode'])}**")
        if failure.get("error_type"):
            _err_step_txt = f" during Step {failure['step']}" if failure.get("step") else ""
            st.caption(f"Error detail: `{failure['error_type']}`{_err_step_txt}")
        st.warning(failure["message"])
        # Generic failure view (all 6 stages, one pattern): if this stage has
        # no live substep events (e.g. stepwise mode), seed the tracker from
        # the recorded step history so the generic renderer displays it.
        _f_live_check = (st.session_state.get("_live_substeps") or {}).get(_f_step)
        if not _f_live_check or not _f_live_check.get("steps"):
            _seed_live_state_from_recorded_steps(_f_step, failure.get("validation_steps"))
        _render_partial_substep_summary()
        if failure.get("partial_output"):
