            if _stage_outs:
                with st.expander("🪜 Review Stage-wise Outputs (Stages 1 to 6)", expanded=False):
                    for _sn in sorted(_stage_outs):
                        _sd = _stage_outs[_sn]
                        _r = _stage3_retry_count(_sd) if _sn == 3 else (_sd.get("retry_count", 0) or 0)
                        _rt = f" 🔄 Retry {_r}" if _r else ""
                        with st.expander(f"✓ Stage {_sn} ({_STAGE_NAMES.get(_sn, '')}) output{_rt}", expanded=False):
                            _ai_in = _sd.get("ai_input") or {}
                            _ai_in = {k: v for k, v in _ai_in.items() if v}
                            if _ai_in:
                                with st.expander(f"📥 Stage {_sn} AI input", expanded=False):
                                    for _ak, _av in _ai_in.items():
                                        st.markdown(f"**{_ak}**")
                                        st.code(str(_av)[:3000], language="text")
                            _ver = _sd.get("verification")
                            if _ver is not None:
                                _v_ok = bool(getattr(_ver, "is_verified", False))
                                _v_conf = getattr(_ver, "confidence_score", "?")
                                st.caption(f"{'✓ Verified' if _v_ok else '⚠️ Warning'} — confidence {_v_conf}%")
                                if _sd.get("verification_from_cache"):
                                    _v_ch = _sd.get("cache_age_hours", 0) or 0
                                    st.caption(f"✓ Used cached verification from {_v_ch:.1f}h ago — API call skipped")
                                _vsum = getattr(_ver, "verification_summary", "") or ""
                                if _vsum:
                                    st.write(_vsum[:500])
                                _vfacts = getattr(_ver, "verified_facts", None) or []
                                if _vfacts:
