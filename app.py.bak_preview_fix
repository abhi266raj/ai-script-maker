                if selected_source != st.session_state.chosen_story_source:
                    st.session_state.chosen_story_source = selected_source
                    save_config("story_source", selected_source)
            is_feed_mode = selected_source != MANUAL_TOPIC_SOURCE
            # The headline fetcher dispatch below keys off this name.
            selected_news_cat = selected_source
            # --- Hashtag sources: resolve the active hashtag before headline fetch ---
            # Each hashtag carries its headline: {"tag", "headline", "link", "source"}.
            active_hashtag = ""
            active_hashtag_article = None
            def _build_hashtag_entries(trend_articles):
                """Build [{tag, headline, link, source}] — every hashtag keeps its headline."""
                entries, seen = [], set()
                for _a in trend_articles:
                    _title = (getattr(_a, "title", "") or "").strip()
                    if not _title:
                        continue
                    _t = re.sub(r"[^\w\s]", "", _title).strip()
                    _tag = "#" + "".join(w.capitalize() for w in _t.split()[:4])
                    if _tag and _tag not in seen:
                        seen.add(_tag)
                        entries.append({
                            "tag": _tag,
                            "headline": _title,
                            "link": getattr(_a, "link", "") or "",
                            "source": getattr(_a, "source", "") or "",
                        })
                return entries[:12]
            def _hashtag_label(entry):
                _hl = entry["headline"]
                return f"{entry['tag']} — {_hl[:70]}{'…' if len(_hl) > 70 else ''}"
            # Real-time verification: warn about content issues BEFORE selection.
            # Returns (severity, message): severity is "error" (blocks generation)
            # or "warning" (advisory) or "" (OK).
            def _verify_headline(title):
                """Return (severity, warning) if the headline looks problematic, else ("", "")."""
                t = (title or "").strip()
                if not t:
                    return ("error", "Empty headline — generation cannot proceed without a valid title.")
                if t.lower().startswith(("untitled", "no title", "null", "none")):
                    return ("error", "Headline looks like a placeholder, not real news.")
                if len(t) < 15:
                    return ("warning", f"Headline very short ({len(t)} chars) — may lack news context.")
                return ("", "")
            def _verify_hashtag(entry):
                """Return (severity, warning) if the hashtag entry looks problematic."""
                hl = (entry.get("headline") or "").strip()
                if not hl:
                    return ("error", f"{entry.get('tag', '')} has no attached headline — cannot generate.")
                return _verify_headline(hl)
            # Render a config issue in the matching style: red for errors, yellow for warnings.
            def _show_config_issue(severity, message):
                if severity == "error":
                    st.markdown(
                        "<div style='background-color:#fdecea;border:1px solid #f5c6cb;"
                        "border-radius:8px;padding:10px;margin:8px 0;'>"
                        f"<b>❌ Config Error:</b> {message}"
                        "</div>",
                        unsafe_allow_html=True,
                    )
                elif severity == "warning":
                    st.markdown(
                        "<div style='background-color:#fff8e1;border:1px solid #ffe082;"
                        "border-radius:8px;padding:10px;margin:8px 0;'>"
                        f"<b>⚠️ Config Warning:</b> {message}"
                        "</div>",
                        unsafe_allow_html=True,
                    )
            if selected_source == TRENDING_HASHTAG_SOURCE:
                # Trending hashtags: derived from live Google Trends India topics.
