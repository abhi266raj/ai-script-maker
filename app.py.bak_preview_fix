# ------------------------------------------------------------------
# Live substep tracking (continuous mode)
# ------------------------------------------------------------------
# The backend pipeline emits substep events (start/progress/complete) from a
# worker thread while the UI pumps the queue. These helpers keep the live
# state in session_state and render the tracker with explicit statuses:
#   ✅ <id> <name> — Passed
#   ❌ <id> <name> — Failed: <reason>
#   🔄 <id> <name> — Running...
#   ⏳ <id> <name> — Waiting
#   ⏸️ <id> <name> — Not needed
def _live_stage_heading(stage_num, substep=None, name="", phase=""):
    """Live heading: 'Stage 3: Dialogue — Running 3.2.1' / '— Complete ✅'."""
    short = _STAGE_SHORT_NAMES.get(stage_num, f"Stage {stage_num}")
    base = f"Stage {stage_num}: {short}"
    if phase == "complete":
        return f"{base} — Complete ✅"
    if phase == "failed":
        at = f" (at {substep})" if substep else ""
        return f"{base} — Failed ❌{at}"
    if substep:
        _nl = (name or "").lower()
        retry_tag = " (Retry)" if ("retry" in _nl or "re-validate" in _nl) else ""
        return f"{base} — Running {substep}{retry_tag}"
    return f"{base} — Starting…"


def _init_live_stage(stage_num):
    """Reset live state for a stage: all planned substeps start as Waiting."""
    steps = {}
    for sid, sname, cond in _SUBSTEP_PLAN.get(stage_num, []):
        steps[sid] = {"name": sname, "status": "waiting" if not cond else "not_needed",
                       "detail": "", "input": "", "output": "", "conditional": cond}
    st.session_state.setdefault("_live_substeps", {})[stage_num] = {
        "steps": steps, "current": None, "done": False, "failed_at": None,
    }


def _apply_live_substep(evt):
    """Fold one backend substep event into session_state; returns stage_num."""
    stage_num = evt.get("step") or evt.get("stage")
    sid = str(evt.get("substep", ""))
    phase = evt.get("phase", "")
    name = evt.get("name", sid)
    live_all = st.session_state.setdefault("_live_substeps", {})
    live = live_all.get(stage_num)
    if live is None:
        _init_live_stage(stage_num)
        live = live_all[stage_num]
    steps = live["steps"]
    entry = steps.get(sid)
    if entry is None:
        # Dynamic substep (e.g. 3.5/3.6 retry rounds): append live.
        entry = {"name": name, "status": "waiting", "detail": "",
                 "input": "", "output": "", "conditional": True}
        steps[sid] = entry
    if phase == "start":
        entry["status"] = "running"
        entry["name"] = name
        live["current"] = sid
        if evt.get("detail"):
            entry["detail"] = str(evt["detail"])
        if evt.get("input"):
            entry["input"] = str(evt["input"])
    elif phase == "progress":
        entry["status"] = "running"
        live["current"] = sid
        if evt.get("detail"):
            entry["detail"] = str(evt["detail"])
    elif phase == "complete":
        entry["status"] = "pass" if evt.get("status") == "pass" else "fail"
        if evt.get("detail"):
            entry["detail"] = str(evt["detail"])
        if evt.get("input"):
            entry["input"] = str(evt["input"])
        if evt.get("output"):
            entry["output"] = str(evt["output"])
        if entry["status"] == "fail":
            live["failed_at"] = sid
        if live.get("current") == sid:
            live["current"] = None
    return stage_num


def _substep_status_line(sid, entry, failure_mode=False):
    """Explicit, unambiguous status line for one substep.

    In failure_mode, substeps that never ran show "Not reached" instead of
    "Waiting" so the failure view reads exactly where the pipeline broke.
    """
    _waiting = ("⏸️", "Not reached") if failure_mode else ("⏳", "Waiting")
    st_map = {
        "pass": ("✅", "Passed"),
        "fail": ("❌", "Failed: " + (entry.get("detail") or "see error")),
        "running": ("🔄", "Running..."),
        "waiting": _waiting,
        "not_needed": ("⏸️", "Not needed"),
    }
    icon, text = st_map.get(entry.get("status"), ("❔", "Unknown"))
    return f"{icon} {sid} {entry.get('name', '')} — {text}"


def _is_subcheck(sid):
    """Sub-checks (3.2.1) nest under their parent validation (3.2)."""
    return len(str(sid).split(".")) == 3


def _render_live_tracker(stage_num, failure_mode=False):
    """THE generic substep renderer: one pattern for all 6 stages.

    Takes the stage number, resolves the stage name from _STAGE_SHORT_NAMES,
    and renders every substep with an explicit ✅/❌/🔄/⏳/⏸️ status line.
    Sub-checks (N.2.1) nest under their parent (N.2). In failure_mode the
    failed substep is expanded with its error + input/output visible, and
    unreached substeps read "Not reached".
    """
    live = (st.session_state.get("_live_substeps") or {}).get(stage_num)
    if not live:
        return
    steps = live["steps"]
    # Top-level substeps first (plan order), then dynamic ones in numeric order.
    def _skey(sid):
        try:
            return tuple(int(p) for p in str(sid).split("."))
        except ValueError:
            return (999,)
    plan_order = [sid for sid, _, _ in _SUBSTEP_PLAN.get(stage_num, [])]
    ordered = [sid for sid in plan_order if sid in steps]
    ordered += sorted((s for s in steps if s not in plan_order and not _is_subcheck(s)), key=_skey)
    for sid in ordered:
        entry = steps[sid]
        expanded = entry.get("status") in ("running", "fail")
        with st.expander(_substep_status_line(sid, entry, failure_mode=failure_mode), expanded=expanded):
            if entry.get("detail"):
                st.caption(entry["detail"])
            if entry.get("input"):
                st.markdown("**📥 Input:**")
                st.caption(entry["input"][:600])
            if entry.get("output"):
                st.markdown("**📤 Output:**")
                st.caption(entry["output"][:600])
            # Nested sub-checks (3.2.1–3.2.4) with their own explicit statuses.
            subs = sorted((s for s in steps if _is_subcheck(s) and str(s).rsplit(".", 1)[0] == sid), key=_skey)
            for sub in subs:
                with st.expander(_substep_status_line(sub, steps[sub], failure_mode=failure_mode), expanded=False):
                    if steps[sub].get("detail"):
                        st.caption(steps[sub]["detail"])
                    if steps[sub].get("input"):
                        st.markdown("**📥 Input:**")
                        st.caption(steps[sub]["input"][:600])
                    if steps[sub].get("output"):
                        st.markdown("**📤 Output:**")
                        st.caption(steps[sub]["output"][:600])


def _seed_live_state_from_recorded_steps(stage_num, vsteps):
    """Generic converter: recorded step history -> live-tracker state shape.

    Used when a stage fails without live events (e.g. stepwise mode): the
    recorded generation/validation steps are folded into the same
    session_state shape the live tracker uses, so the ONE generic renderer
    displays them. Takes any stage number and any recorded steps.
    """
    if not vsteps:
        return
    live_all = st.session_state.setdefault("_live_substeps", {})
    if stage_num in live_all and live_all[stage_num].get("steps"):
        return  # live events already present; don't overwrite
    steps = {}
    failed_at = None
    for stp in vsteps:
        sid = str(stp.get("stage", ""))
        if not sid:
            continue
        _p = stp.get("passed")
        status = "pass" if _p else ("fail" if _p is False else "waiting")
        steps[sid] = {
            "name": stp.get("name", sid),
            "status": status,
            "detail": "" if status == "pass" else str(stp.get("output", ""))[:200],
            "input": str(stp.get("input", ""))[:600],
            "output": str(stp.get("output", ""))[:600],
            "conditional": False,
        }
        if status == "fail" and failed_at is None:
            failed_at = sid
        for sub in stp.get("sub_checks") or []:
            sub_id = str(sub.get("stage", ""))
            if not sub_id:
                continue
            _sp = sub.get("passed")
            sub_status = "pass" if _sp else "fail"
            steps[sub_id] = {
                "name": sub.get("name", sub_id),
                "status": sub_status,
                "detail": "" if sub_status == "pass" else str(sub.get("output", ""))[:200],
                "input": str(sub.get("input", ""))[:600],
                "output": str(sub.get("output", ""))[:600],
                "conditional": False,
            }
            if sub_status == "fail" and failed_at is None:
                failed_at = sub_id
    live_all[stage_num] = {"steps": steps, "current": None,
                           "done": False, "failed_at": failed_at}


def _render_partial_substep_summary():
    """Generic failure view — ONE pattern for all 6 stages:

        Stage N: {name} — Failed ❌ (at {substep})
        ├── ✅ N.1 {name} — Passed [collapsible]
        ├── ❌ N.2 {name} — Failed
        │   ├── ✅ N.2.1 {check} — Passed [collapsible]
        │   ├── ❌ N.2.2 {check} — Failed: {reason} [collapsible: input/output/error]
        │   └── ⏸️ N.2.3 {check} — Not reached
        ├── ⏸️ N.3 {name} — Not reached
        └── ⏸️ N.4 {name} — Not reached

    The failed stage gets the full collapsible tracker with the failed
    substep expanded (error + input/output visible). Completed stages show
    their substeps collapsed; never-started stages read "Not reached".
    """
    live_all = st.session_state.get("_live_substeps") or {}
    if not live_all:
        return
    st.markdown("#### 🧭 Substep Summary")
    for stage_num in range(1, 7):
        live = live_all.get(stage_num)
        short = _STAGE_SHORT_NAMES.get(stage_num, f"Stage {stage_num}")
        if live and live.get("failed_at"):
            st.markdown(f"**Stage {stage_num}: {short} — Failed ❌ (at {live['failed_at']})**")
            _render_live_tracker(stage_num, failure_mode=True)
        elif live and live.get("done"):
            st.markdown(f"**Stage {stage_num}: {short} — Complete ✅**")
            _render_live_tracker(stage_num, failure_mode=True)
        elif live:
            st.markdown(f"**Stage {stage_num}: {short} — Incomplete ⏸️**")
            _render_live_tracker(stage_num, failure_mode=True)
        else:
            st.markdown(f"**Stage {stage_num}: {short} — Not reached ⏸️**")


