                "Output received before failure",
                value=failure["partial_output"],
                height=180,
                disabled=True,
                label_visibility="collapsed",
            )
        # Fallback: raw attempt history — only when no substep data exists
        # (the generic substep summary above is the primary failure view).
        _fail_attempts = failure.get("attempt_history") or []
        _has_substeps = bool((st.session_state.get("_live_substeps") or {}).get(_f_step, {}).get("steps"))
        if _fail_attempts and not _has_substeps:
            st.markdown("#### 🔄 Attempts")
            for _a_idx, _a_out in enumerate(_fail_attempts, 1):
                _a_is_last = (_a_idx == len(_fail_attempts))
                with st.expander(
                    f"🔄 Attempt {_a_idx}" + (" (final)" if _a_is_last else ""),
                    expanded=_a_is_last,
                ):
                    st.text_area(
                        f"Attempt {_a_idx} output",
