#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────
# runut — standardized test runner for Hindi Reel Studio
# ──────────────────────────────────────────────────────────────────────
# Runs pytest on the given test files (or the full suite) and prints a
# concise failure report that's easy to paste back for diagnosis.
#
# Usage:
#   ./runut tests/test_foo.py tests/test_bar.py   # targeted
#   ./runut                                        # full suite
#   ./runut --baseline tests/test_foo.py           # also run on pristine
#                                                  # develop to tell
#                                                  # pre-existing failures
#                                                  # apart from regressions
#
# Exit code: 0 when all tests pass, 1 otherwise.
# ──────────────────────────────────────────────────────────────────────
set -u

VENV_PY=""

# Locate the project venv: explicit $HRS_VENV wins, then the repo root's
# .venv (the script's own directory, resolving the ./runut symlink),
# then ./​.venv, then PATH python.
_SRC="${BASH_SOURCE[0]}"
while [ -L "$_SRC" ]; do  # resolve ./runut -> scripts/runut symlink
    _DIR="$(cd "$(dirname "$_SRC")" && pwd)"
    _SRC="$(readlink "$_SRC")"
    case "$_SRC" in
        /*) ;;
        *) _SRC="$_DIR/$_SRC" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$_SRC")" && pwd)"
# scripts/ -> repo root
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ -n "${HRS_VENV:-}" ] && [ -x "$HRS_VENV/bin/python" ]; then
    VENV_PY="$HRS_VENV/bin/python"
elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    VENV_PY="$REPO_ROOT/.venv/bin/python"
elif [ -x "./.venv/bin/python" ]; then
    VENV_PY="./.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    VENV_PY="python3"
else
    echo "runut: no python found" >&2
    exit 2
fi

BASELINE=0
ARGS=()
for a in "$@"; do
    case "$a" in
        --baseline) BASELINE=1 ;;
        *) ARGS+=("$a") ;;
    esac
done

if [ "${#ARGS[@]}" -eq 0 ]; then
    ARGS=("tests/")
fi

echo "━━━ runut: pytest ${ARGS[*]} ━━━"
# Stream live with per-test percentage (-v shows "[ 42%]" per test).
# Tee to a temp file so we can still print the concise failure summary.
LOG="$(mktemp)"
"$VENV_PY" -m pytest "${ARGS[@]}" -v 2>&1 | tee "$LOG"
CODE=${PIPESTATUS[0]}
echo ""
echo "━━━ failures ━━━"
grep -E "^(FAILED|ERROR)" "$LOG" || echo "(none)"
tail -2 "$LOG"
rm -f "$LOG"

if [ "$BASELINE" -eq 1 ] && [ "$CODE" -ne 0 ]; then
    echo ""
    echo "━━━ runut: baseline on pristine develop ━━━"
    WORKTREE="$(mktemp -d)/pristine"
    if git worktree add "$WORKTREE" refs/remotes/origin/develop >/dev/null 2>&1; then
        (cd "$WORKTREE" && "$VENV_PY" -m pytest "${ARGS[@]}" -q 2>&1 \
            | grep -E "^(FAILED|ERROR)" || true)
        git worktree remove --force "$WORKTREE" >/dev/null 2>&1
        echo "— compare: failures above on BOTH = pre-existing; only in your"
        echo "  branch = regression from your change."
    else
        echo "runut: could not create pristine worktree (is origin/develop fetched?)" >&2
    fi
fi

exit "$CODE"
